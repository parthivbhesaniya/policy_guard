GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional -- only needed for `python -m policyguard.evaluation.run_eval --langsmith`
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=policyguard
LANGSMITH_TRACING=true

# Optional -- powers reranking in the LangGraph orchestrator (pass --no-rerank to skip it)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
